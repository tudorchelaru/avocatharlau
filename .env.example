# SMTP for the contact form (/api/contact). Brevo: smtp-relay.brevo.com, port 587,
# user = Brevo SMTP login, pass = Brevo SMTP key.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender address (must be a verified sender in Brevo)
SMTP_FROM=contact@avocatharlau.ro
# Where contact form messages are delivered
CONTACT_TO=contact@avocatharlau.ro
