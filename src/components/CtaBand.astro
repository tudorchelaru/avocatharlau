---
import { SITE } from "../data/site";

interface Props {
  title?: string;
  text?: string;
}

const {
  title = "Aveți nevoie de asistență juridică?",
  text = "Contactați-ne pentru o consultație inițială. Suntem aici să vă ajutăm.",
} = Astro.props;
---

<section class="cta-band">
  <div class="wrap cta-band__inner">
    <div>
      <h2>{title}</h2>
      <p>{text}</p>
    </div>
    <div class="hero__actions">
      <a href="/contact" class="btn btn--gold">Contactează-ne</a>
      <a href={SITE.phoneHref} class="btn btn--ghost">{SITE.phone}</a>
    </div>
  </div>
</section>
