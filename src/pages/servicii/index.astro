---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceIcon from "../../components/ServiceIcon.astro";
import CtaBand from "../../components/CtaBand.astro";
import { SITE, SERVICES } from "../../data/site";

export const prerender = true;

const itemList = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Servicii juridice în Hârlău",
  itemListElement: SERVICES.map((s, i) => ({
    "@type": "ListItem",
    position: i + 1,
    url: `${SITE.url}/servicii/${s.slug}`,
    name: s.title,
  })),
};
---

<Base
  title="Servicii juridice în Hârlău – Arii de practică"
  description="Servicii juridice în Hârlău: dreptul familiei, succesiuni, dreptul muncii, contestare amenzi, drept bancar și contencios administrativ."
  path="/servicii"
  jsonLd={[itemList]}
>
  <PageHero
    eyebrow="Arii de practică"
    title="Servicii juridice în Hârlău"
    lead="Consultanță și reprezentare în domeniile cel mai des solicitate de clienții din Hârlău și din comunele arondate Judecătoriei Hârlău."
    crumbs={[{ label: "Servicii" }]}
  />

  <section class="section">
    <div class="wrap">
      <ul class="cards">
        {
          SERVICES.map((s) => (
            <li class="card card--link">
              <ServiceIcon name={s.icon} />
              <h2 class="card__title">
                <a href={`/servicii/${s.slug}`}>{s.title}</a>
              </h2>
              <p>{s.short}</p>
              <span class="card__more" aria-hidden="true">Detalii →</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
