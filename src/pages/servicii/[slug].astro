---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import CtaBand from "../../components/CtaBand.astro";
import { SITE, SERVICES, type Service } from "../../data/site";

export const prerender = true;

export function getStaticPaths() {
  return SERVICES.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}

const { service } = Astro.props as { service: Service };
const path = `/servicii/${service.slug}`;
const others = SERVICES.filter((s) => s.slug !== service.slug);

const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `${service.title} – avocat Hârlău`,
  serviceType: service.title,
  description: service.seoDescription,
  url: `${SITE.url}${path}`,
  provider: { "@id": `${SITE.url}/#cabinet` },
  areaServed: [
    { "@type": "City", name: "Hârlău" },
    { "@type": "AdministrativeArea", name: "Județul Iași" },
  ],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: service.faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<Base title={service.seoTitle} description={service.seoDescription} path={path} jsonLd={[serviceSchema, faqSchema]}>
  <PageHero
    eyebrow="Avocat Hârlău"
    title={service.title}
    lead={service.intro}
    crumbs={[{ label: "Servicii", href: "/servicii" }, { label: service.title }]}
  />

  <section class="section">
    <div class="wrap article">
      <article class="prose">
        <h2>Cu ce vă pot ajuta</h2>
        <ul class="checklist">
          {service.topics.map((t) => <li>{t}</li>)}
        </ul>

        {
          service.sections.map((sec) => (
            <>
              <h2>{sec.heading}</h2>
              {sec.body.map((p) => <p>{p}</p>)}
            </>
          ))
        }

        <h2>Întrebări frecvente</h2>
        <div class="faq__list">
          {
            service.faq.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>

        <p class="note">
          Informațiile de pe această pagină au caracter general și nu înlocuiesc o consultație juridică. Fiecare situație
          are particularitățile ei — pentru o evaluare concretă, <a href="/contact">programați o consultație</a>.
        </p>
      </article>

      <aside class="aside">
        <div class="aside__card aside__card--dark">
          <p class="eyebrow">Programare</p>
          <p class="aside__title">Discutăm situația dumneavoastră</p>
          <p>Online, la cabinetul din Iași sau la Hârlău, pe bază de programare.</p>
          <a href={SITE.phoneHref} class="btn btn--gold btn--block">Sună · {SITE.phone}</a>
          <a href={SITE.whatsapp} class="btn btn--ghost btn--block" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
        <nav class="aside__card" aria-label="Alte servicii">
          <p class="aside__title">Alte servicii</p>
          <ul class="aside__links">
            {others.map((s) => <li><a href={`/servicii/${s.slug}`}>{s.title}</a></li>)}
          </ul>
        </nav>
      </aside>
    </div>
  </section>

  <CtaBand />
</Base>
