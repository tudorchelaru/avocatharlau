---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import TeamProfiles from "../components/TeamProfiles.astro";
import Icon from "../components/Icon.astro";
import { SITE, TEAM } from "../data/site";
export const prerender = true;
const aboutPage = {
  "@context": "https://schema.org",
  "@type": "AboutPage",
  url: `${SITE.url}/despre-noi`,
  about: TEAM.map((p) => ({ "@id": `${SITE.url}/#${p.slug}` })),
};
---

<Base
  title="Despre noi – Chelaru, Botezatu, Chiperi"
  description="Cunoaște avocații Andreea Chelaru, Răzvan Botezatu și Roxana Chiperi. Consultanță și reprezentare juridică pentru Hârlău și împrejurimi."
  path="/despre-noi"
  jsonLd={[aboutPage]}
>
  <PageHero
    eyebrow="Despre noi"
    title="Trei avocați. O abordare personală."
    lead="Andreea Chelaru, Răzvan Botezatu și Roxana Chiperi. Consultanță și reprezentare juridică, cu atenție la oameni și la situația fiecăruia."
    crumbs={[{ label: "Despre noi" }]}
    image={{
      base: "/images/hero/avocati-harlau-chelaru-botezatu-chiperi-andreea-v3",
      alt: "Andreea Chelaru, Răzvan Botezatu și Roxana Chiperi împreună într-un birou.",
    }}
  />
  <section class="section">
    <div class="wrap about-intro" data-reveal>
      <h2>
        Încrederea începe
        <br />
        cu o conversație.
      </h2>
      <div class="prose">
        <p>
          Abordăm fiecare caz cu profesionalism, dedicare și atenție la detalii,
          punând interesele clienților pe primul loc.
        </p>
        <p>
          Oferim consultanță și reprezentare în domeniile prezentate pe site.
          Înainte de a stabili pașii următori, discutăm despre situația ta și
          documentele relevante.
        </p>
        <a class="text-link" href="/servicii">
          Descoperă serviciile <Icon />
        </a>
      </div>
    </div>
  </section>
  <section class="section section--paper">
    <div class="wrap">
      <header class="section__head" data-reveal>
        <p class="eyebrow">Cunoaște-ne</p>
        <h2>Oameni în care poți avea încredere.</h2>
      </header>
      <TeamProfiles detailed />
    </div>
  </section>
  <section class="section">
    <div class="wrap office" data-reveal>
      <div>
        <p class="eyebrow">Programări</p>
        <h2>Unde ne întâlnim</h2>
        <p>
          {SITE.officeHarlau} Programările se fac telefonic sau prin email, iar
          consultația poate avea loc și online.
        </p>
      </div>
      <a href="/contact" class="btn btn--gold">
        Programează o consultație <Icon />
      </a>
    </div>
  </section>
  <CtaBand />
</Base>
