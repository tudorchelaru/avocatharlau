---
import Base from "../layouts/Base.astro";

export const prerender = true;
---

<Base
  title="Pagina nu a fost găsită"
  description="Pagina căutată nu există. Reveniți la pagina principală AvocatHârlău.ro."
  path="/404"
  noindex
>
  <section class="page-hero page-hero--center">
    <div class="wrap">
      <p class="eyebrow">Eroare 404</p>
      <h1>Pagina nu a fost găsită</h1>
      <p class="page-hero__lead">Adresa accesată nu există sau a fost mutată.</p>
      <div class="hero__actions hero__actions--center">
        <a href="/" class="btn btn--gold">Pagina principală</a>
        <a href="/despre-noi" class="btn btn--ghost">Despre noi</a>
        <a href="/contact" class="btn btn--ghost">Contact</a>
      </div>
    </div>
  </section>
</Base>
