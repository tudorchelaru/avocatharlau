---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import { SITE } from "../data/site";

export const prerender = true;

const contactPage = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  url: `${SITE.url}/contact`,
  about: { "@id": `${SITE.url}/#cabinet` },
};
---

<Base
  title="Contact – Programare consultație avocat Hârlău"
  description={`Programați o consultație cu avocat Andreea Chelaru: telefon ${SITE.phone}, WhatsApp sau email. Online, la cabinetul din Iași sau la Hârlău.`}
  path="/contact"
  jsonLd={[contactPage]}
>
  <PageHero
    eyebrow="Contact"
    title="Programați o consultație"
    lead="Cel mai rapid mă găsiți la telefon sau pe WhatsApp. Stabilim împreună dacă ne vedem online, la Iași sau la Hârlău."
    crumbs={[{ label: "Contact" }]}
  />

  <section class="section">
    <div class="wrap contact">
      <div class="contact__intro">
        <h2>Date de contact</h2>
        <p>
          Pentru o primă evaluare, pregătiți pe scurt situația și, dacă aveți, documentele relevante: contracte,
          hotărâri, procese-verbale sau notificări.
        </p>
        <div class="hero__actions">
          <a href={SITE.phoneHref} class="btn btn--gold">Sună · {SITE.phone}</a>
          <a href={SITE.whatsapp} class="btn btn--outline" target="_blank" rel="noopener noreferrer">WhatsApp</a>
        </div>
      </div>
      <address class="contact__list">
        <div>
          <span class="contact__label">Telefon</span>
          <a href={SITE.phoneHref}>{SITE.phone}</a>
        </div>
        <div>
          <span class="contact__label">Email</span>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </div>
        <div>
          <span class="contact__label">Cabinet Iași</span>
          <span>
            {SITE.officeIasi}<br />
            <a href={SITE.mapsUrl} target="_blank" rel="noopener noreferrer" class="contact__map">Deschide în Google Maps</a>
          </span>
        </div>
        <div>
          <span class="contact__label">Cabinet Hârlău</span>
          <span>{SITE.officeHarlau}</span>
        </div>
        <div>
          <span class="contact__label">Program</span>
          <span>{SITE.hours}</span>
        </div>
      </address>
    </div>
  </section>
</Base>
