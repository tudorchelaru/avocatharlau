---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, STEPS, yearsOfPractice } from "../data/site";

export const prerender = true;

const profile = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  url: `${SITE.url}/despre`,
  mainEntity: {
    "@type": "Person",
    "@id": `${SITE.url}/#andreea-chelaru`,
    name: "Andreea Chelaru",
    jobTitle: "Avocat",
    image: `${SITE.url}/images/avocat-harlau-andreea-chelaru-700.webp`,
    worksFor: { "@id": `${SITE.url}/#cabinet` },
    memberOf: { "@type": "Organization", name: "Baroul Iași", url: "https://www.barouliasi.ro/" },
    url: `${SITE.url}/despre`,
    sameAs: ["https://avocatchelaru.ro/"],
  },
};
---

<Base
  title="Despre – Avocat Andreea Chelaru, Baroul Iași"
  description={`Andreea Chelaru, avocat în Baroul Iași din ${SITE.since}. Consultanță și reprezentare juridică pentru clienții din Hârlău și zona Cotnari, cu rigoare, empatie și transparență.`}
  path="/despre"
  jsonLd={[profile]}
>
  <PageHero
    eyebrow="Despre"
    title="Andreea Chelaru, avocat în Baroul Iași"
    lead={`${yearsOfPractice()}+ ani de practică, în slujba clienților din Hârlău și din comunele din jur.`}
    crumbs={[{ label: "Despre" }]}
  />

  <section class="section">
    <div class="wrap about about--page">
      <figure class="about__photo">
        <img
          src="/images/avocat-harlau-andreea-chelaru-700.webp"
          alt="Andreea Chelaru, avocat în Baroul Iași"
          width="700"
          height="1050"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <div class="prose">
        <p>
          Profesez în <a href="https://www.barouliasi.ro/" target="_blank" rel="noopener noreferrer">Baroul Iași</a> din
          {SITE.since}. Ofer consultanță și reprezentare juridică clienților din Hârlău și zona Cotnari — online sau la
          cabinetul din Iași, cu posibilitatea deplasării la Hârlău prin programare.
        </p>
        <p>
          Activitatea mea acoperă în special <a href="/servicii/dreptul-familiei">dreptul familiei</a>,
          <a href="/servicii/drept-civil">dreptul civil</a>, <a href="/servicii/dreptul-muncii">dreptul muncii</a> și
          <a href="/servicii/drept-contraventional">dreptul contravențional</a> — domeniile cel mai frecvent solicitate de
          clienții din Hârlău și din comunele arondate Judecătoriei Hârlău.
        </p>
        <p>
          Judecătoria Hârlău face parte din circumscripția Tribunalului Iași. Reprezint clienți în fața acestor instanțe
          în cauze civile, de familie și contravenționale.
        </p>
        <blockquote class="pull">
          Fiecare dosar este tratat cu rigoare juridică, empatie și transparență, astfel încât să știți mereu unde ne
          aflăm și care sunt pașii următori.
        </blockquote>
        <p>
          Construiesc strategia pornind de la obiectivele dumneavoastră și comunic deschis pe tot parcursul colaborării,
          de la prima discuție până la soluționarea cauzei.
        </p>
      </div>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow eyebrow--dark">Cum lucrez</p>
        <h2>De la primul telefon până la hotărâre</h2>
      </header>
      <ol class="steps">
        {
          STEPS.map((s, i) => (
            <li class="step">
              <span class="step__num">{String(i + 1).padStart(2, "0")}</span>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <CtaBand />
</Base>
