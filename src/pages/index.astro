---
import Base from "../layouts/Base.astro";
import CtaBand from "../components/CtaBand.astro";
import { SITE, AREAS, LOCALITIES, STATS } from "../data/site";

export const prerender = true;

const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  name: SITE.name,
  url: `${SITE.url}/`,
  inLanguage: "ro-RO",
  publisher: { "@id": `${SITE.url}/#cabinet` },
};
---

<Base
  title="Avocat Hârlău – Chelaru, Botezatu, Chiperi | AvocatHârlău.ro"
  description="Casa de avocatură Chelaru | Botezatu | Chiperi – peste 22 de ani de experiență. Dreptul familiei, drept civil, penal, imigrări, executări silite pentru clienții din Hârlău."
  path="/"
  jsonLd={[website]}
>
  <section class="hero hero--text">
    <div class="wrap">
      <p class="eyebrow">Chelaru · Botezatu · Chiperi</p>
      <h1>
        Casa de avocatură<br />
        <em>pentru Hârlău și împrejurimi</em>
      </h1>
      <p class="hero__lede">{SITE.tagline}</p>
      <div class="hero__actions">
        <a href="/contact" class="btn btn--gold">Programează o consultație</a>
        <a href="/despre-noi" class="btn btn--ghost">Despre noi</a>
      </div>
      <dl class="stats">
        {
          STATS.map((s) => (
            <div>
              <dt>{s.value}</dt>
              <dd>{s.label}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow eyebrow--dark">Ce facem</p>
        <h2>Domenii de activitate</h2>
      </header>
      <ul class="cards cards--areas">
        {
          AREAS.map((a) => (
            <li class="card card--link">
              <h3>
                <a href={`/${a.slug}`}>{a.title}</a>
              </h3>
              <p>{a.short}</p>
              <span class="card__more" aria-hidden="true">Află mai multe →</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section section--paper">
    <div class="wrap about">
      <div class="about__quote">
        <span class="about__mark" aria-hidden="true">“</span>
        <blockquote>
          Abordăm fiecare caz cu profesionalism, dedicare și atenție la detalii, punând interesele clienților noștri pe
          primul loc.
        </blockquote>
        <p class="about__sign">Chelaru · Botezatu · Chiperi</p>
      </div>
      <div class="about__text">
        <p class="eyebrow eyebrow--dark">Despre noi</p>
        <h2>De ce să ne alegeți?</h2>
        <p>
          Cu o experiență de peste 22 de ani în domeniul juridic, cabinetul nostru de avocatură oferă servicii complete
          de consultanță și reprezentare. Abordăm fiecare caz cu profesionalism, dedicare și atenție la detalii, punând
          interesele clienților noștri pe primul loc.
        </p>
        <a href="/despre-noi" class="link-arrow">Află mai multe despre noi</a>
      </div>
    </div>
  </section>

  <section class="section section--dark">
    <div class="wrap zone">
      <div>
        <p class="eyebrow">Zona deservită</p>
        <h2>Hârlău și comunele arondate Judecătoriei Hârlău</h2>
        <p>
          Consultanță online sau la sediul din Iași, cu posibilitatea deplasării la Hârlău pe bază de programare.
        </p>
      </div>
      <ul class="chips" aria-label="Localități deservite">
        {LOCALITIES.map((l) => <li>{l}</li>)}
      </ul>
    </div>
  </section>

  <CtaBand />
</Base>
