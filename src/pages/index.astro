---
import "../styles/global.css";

const site = "https://avocatharlau.ro";
const title = "Avocat Hârlău | Andreea Chelaru – Baroul Iași";
const description =
  "Avocat Andreea Chelaru – consultanță și reprezentare juridică pentru clienți din Hârlău și zona Cotnari. Membră a Baroului Iași din 2008. Dreptul familiei, drept civil, dreptul muncii, contravențional.";

const phone = "+40 744 484 136";
const phoneHref = "tel:+40744484136";
const whatsapp = "https://wa.me/40744484136";
const email = "andreea@avocatchelaru.ro";
const yearsOfPractice = new Date().getFullYear() - 2008;

const services = [
  {
    title: "Dreptul familiei",
    text: "Divorț, autoritate părintească, stabilirea locuinței minorului, pensie de întreținere și partaj.",
    icon: "family",
  },
  {
    title: "Drept civil",
    text: "Succesiuni și moșteniri, contracte, răspundere civilă, litigii între vecini și acțiuni în revendicare.",
    icon: "scale",
  },
  {
    title: "Dreptul muncii",
    text: "Contestarea deciziei de concediere, conflicte de muncă, recuperarea drepturilor salariale.",
    icon: "briefcase",
  },
  {
    title: "Drept contravențional",
    text: "Plângeri împotriva proceselor-verbale și contestarea amenzilor aplicate în mod nelegal.",
    icon: "doc",
  },
  {
    title: "Drept comercial și bancar",
    text: "Litigii comerciale, clauze abuzive din contractele de credit, contestații la executare silită.",
    icon: "bank",
  },
  {
    title: "Contencios administrativ",
    text: "Litigii cu primăria și cu instituțiile publice locale, anularea actelor administrative.",
    icon: "building",
  },
];

const steps = [
  {
    title: "Programare",
    text: "Sunați sau scrieți pe WhatsApp. Stabilim împreună ora și forma consultației: online, la cabinetul din Iași sau la Hârlău.",
  },
  {
    title: "Analiza situației",
    text: "Evaluez documentele și faptele, identific riscurile și vă explic clar opțiunile și șansele reale de reușită.",
  },
  {
    title: "Strategie",
    text: "Construim o strategie pornind de la obiectivele dumneavoastră, cu pași concreți și termene previzibile.",
  },
  {
    title: "Reprezentare",
    text: "Vă reprezint în fața Judecătoriei Hârlău și a Tribunalului Iași și vă țin la curent la fiecare etapă.",
  },
];

const localities = [
  "Hârlău",
  "Cotnari",
  "Scobinți",
  "Belcești",
  "Sipote",
  "Plugari",
  "Deleni",
  "Erbiceni",
  "Focuri",
];

const faq = [
  {
    q: "Pot avea o consultație fără să mă deplasez la Iași?",
    a: "Da. Consultația poate avea loc online (telefon sau video), iar pentru întâlniri față în față mă pot deplasa la Hârlău, pe bază de programare.",
  },
  {
    q: "Mă puteți reprezenta la Judecătoria Hârlău?",
    a: "Da. Reprezint clienți în fața Judecătoriei Hârlău, în cauze civile, de familie și contravenționale, precum și în fața Tribunalului Iași, în a cărui circumscripție se află judecătoria.",
  },
  {
    q: "Ce documente să pregătesc pentru prima discuție?",
    a: "Orice act legat de situația dumneavoastră: contracte, hotărâri judecătorești, procese-verbale, notificări sau corespondență. Dacă nu știți ce este relevant, aduceți tot și le analizăm împreună.",
  },
  {
    q: "Cât durează un proces?",
    a: "Durata depinde de tipul cauzei, de numărul de termene și de complexitatea probelor. La consultație vă ofer o estimare realistă pentru situația concretă.",
  },
  {
    q: "Ce se întâmplă dacă am primit o amendă pe care o consider nedreaptă?",
    a: "Plângerea contravențională are un termen scurt, de regulă 15 zile de la comunicarea procesului-verbal. Contactați-mă cât mai repede pentru a nu pierde termenul.",
  },
];

const legalService = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "@id": `${site}/#legalservice`,
  name: "Cabinet Avocat Andreea Chelaru – Hârlău",
  url: `${site}/`,
  telephone: phone,
  email,
  description,
  image: `${site}/images/og-avocat-harlau.jpg`,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Anastasie Panu 23, Bloc Muntenia, Et. 1",
    addressLocality: "Iași",
    addressRegion: "Iași",
    addressCountry: "RO",
  },
  areaServed: [
    { "@type": "City", name: "Hârlău" },
    { "@type": "City", name: "Cotnari" },
    { "@type": "AdministrativeArea", name: "Județul Iași" },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "17:00",
  },
  sameAs: ["https://avocatchelaru.ro/", "https://www.barouliasi.ro/"],
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={`${site}/`} />
    <meta name="theme-color" content="#13110F" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={`${site}/`} />
    <meta property="og:image" content={`${site}/images/og-avocat-harlau.jpg`} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Mulish:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      as="image"
      href="/images/avocat-harlau-andreea-chelaru-700.webp"
      imagesrcset="/images/avocat-harlau-andreea-chelaru-700.webp 700w, /images/avocat-harlau-andreea-chelaru-1260.webp 1260w"
      imagesizes="(max-width: 900px) 80vw, 460px"
    />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(legalService)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />
  </head>

  <body>
    <a class="skip" href="#continut">Sari la conținut</a>

    <header class="topbar">
      <div class="wrap topbar__inner">
        <a href="/" class="brand" aria-label="Andreea Chelaru – Avocat, pagina principală">
          <img src="/images/logo.webp" alt="Andreea Chelaru – Avocat" width="600" height="121" />
        </a>
        <nav class="nav" aria-label="Navigare principală">
          <a href="#servicii">Servicii</a>
          <a href="#despre">Despre</a>
          <a href="#cum-lucrez">Cum lucrez</a>
          <a href="#intrebari">Întrebări</a>
          <a href="#contact">Contact</a>
        </nav>
        <a href={phoneHref} class="btn btn--gold btn--sm topbar__call">{phone}</a>
      </div>
    </header>

    <main id="continut">
      <!-- HERO -->
      <section class="hero">
        <div class="wrap hero__grid">
          <div class="hero__copy">
            <p class="eyebrow">Avocat în Hârlău · Baroul Iași din 2008</p>
            <h1>
              Sprijin juridic clar,<br />
              <em>aproape de casă.</em>
            </h1>
            <p class="hero__lede">
              Sunt Andreea Chelaru, avocat în Baroul Iași. Ofer consultanță și reprezentare juridică pentru
              clienții din Hârlău și zona Cotnari, cu rigoare, empatie și transparență în fiecare dosar.
            </p>
            <div class="hero__actions">
              <a href={phoneHref} class="btn btn--gold">Sună acum</a>
              <a href={whatsapp} class="btn btn--ghost" target="_blank" rel="noopener noreferrer">Scrie pe WhatsApp</a>
            </div>
            <dl class="stats">
              <div>
                <dt>{yearsOfPractice}+</dt>
                <dd>ani de practică</dd>
              </div>
              <div>
                <dt>6</dt>
                <dd>arii de practică</dd>
              </div>
              <div>
                <dt>Online</dt>
                <dd>sau la cabinet</dd>
              </div>
            </dl>
          </div>
          <figure class="hero__media">
            <img
              src="/images/avocat-harlau-andreea-chelaru-700.webp"
              srcset="/images/avocat-harlau-andreea-chelaru-700.webp 700w, /images/avocat-harlau-andreea-chelaru-1260.webp 1260w"
              sizes="(max-width: 900px) 80vw, 460px"
              alt="Avocat Andreea Chelaru – consultanță juridică în Hârlău"
              width="1260"
              height="1890"
              fetchpriority="high"
              decoding="async"
            />
          </figure>
        </div>
      </section>

      <!-- SERVICII -->
      <section class="section" id="servicii">
        <div class="wrap">
          <header class="section__head">
            <p class="eyebrow eyebrow--dark">Arii de practică</p>
            <h2>Servicii juridice pentru Hârlău și împrejurimi</h2>
            <p class="section__intro">
              Domeniile cel mai des solicitate de clienții din Hârlău și din comunele arondate Judecătoriei Hârlău.
            </p>
          </header>
          <ul class="cards">
            {
              services.map((s) => (
                <li class="card">
                  <span class="card__icon" aria-hidden="true">
                    {s.icon === "family" && (
                      <svg viewBox="0 0 24 24"><circle cx="8" cy="7" r="3" /><circle cx="17" cy="8.5" r="2.3" /><path d="M2.5 20c0-3.5 2.5-6 5.5-6s5.5 2.5 5.5 6M13.5 20c.3-2.8 1.8-4.8 3.5-4.8 2 0 3.8 2 4.3 4.8" /></svg>
                    )}
                    {s.icon === "scale" && (
                      <svg viewBox="0 0 24 24"><path d="M12 3v18M7 21h10M4 7h16M6.5 7 3.5 14a3 3 0 0 0 6 0L6.5 7ZM17.5 7l-3 7a3 3 0 0 0 6 0l-3-7Z" /></svg>
                    )}
                    {s.icon === "briefcase" && (
                      <svg viewBox="0 0 24 24"><rect x="3" y="7" width="18" height="13" rx="2" /><path d="M9 7V5a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2M3 13h18" /></svg>
                    )}
                    {s.icon === "doc" && (
                      <svg viewBox="0 0 24 24"><path d="M14 3H6a1 1 0 0 0-1 1v16a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1V8l-5-5Z" /><path d="M14 3v5h5M8.5 13h7M8.5 17h5" /></svg>
                    )}
                    {s.icon === "bank" && (
                      <svg viewBox="0 0 24 24"><path d="M3 9.5 12 4l9 5.5M5 10v8M9.5 10v8M14.5 10v8M19 10v8M3 20.5h18" /></svg>
                    )}
                    {s.icon === "building" && (
                      <svg viewBox="0 0 24 24"><rect x="5" y="3" width="14" height="18" rx="1" /><path d="M9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2M10.5 21v-3h3v3" /></svg>
                    )}
                  </span>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </li>
              ))
            }
          </ul>
        </div>
      </section>

      <!-- DESPRE -->
      <section class="section section--paper" id="despre">
        <div class="wrap about">
          <div class="about__quote">
            <span class="about__mark" aria-hidden="true">“</span>
            <blockquote>
              Fiecare dosar este tratat cu rigoare juridică, empatie și transparență, astfel încât să știți mereu
              unde ne aflăm și care sunt pașii următori.
            </blockquote>
            <p class="about__sign">Andreea Chelaru</p>
          </div>
          <div class="about__text">
            <p class="eyebrow eyebrow--dark">Despre</p>
            <h2>Un avocat din Baroul Iași, pentru comunitatea din Hârlău</h2>
            <p>
              Profesez în <a href="https://www.barouliasi.ro/" target="_blank" rel="noopener noreferrer">Baroul Iași</a>
              din 2008. Lucrez cu clienți din Hârlău și din comunele din jur, în special pe dreptul familiei, drept
              civil, dreptul muncii și drept contravențional.
            </p>
            <p>
              Judecătoria Hârlău face parte din circumscripția Tribunalului Iași. Reprezint clienți în fața acestei
              instanțe în cauze civile, de familie și contravenționale, indiferent dacă locuiți în oraș sau în
              comunele limitrofe.
            </p>
            <p>
              Construiesc strategia pornind de la obiectivele dumneavoastră și comunic deschis pe tot parcursul
              colaborării, de la prima discuție până la soluționarea cauzei.
            </p>
          </div>
        </div>
      </section>

      <!-- CUM LUCREZ -->
      <section class="section" id="cum-lucrez">
        <div class="wrap">
          <header class="section__head">
            <p class="eyebrow eyebrow--dark">Cum lucrez</p>
            <h2>De la primul telefon până la hotărâre</h2>
          </header>
          <ol class="steps">
            {
              steps.map((s, i) => (
                <li class="step">
                  <span class="step__num">{String(i + 1).padStart(2, "0")}</span>
                  <h3>{s.title}</h3>
                  <p>{s.text}</p>
                </li>
              ))
            }
          </ol>
        </div>
      </section>

      <!-- ZONA -->
      <section class="section section--dark" id="zona">
        <div class="wrap zone">
          <div>
            <p class="eyebrow">Zona deservită</p>
            <h2>Hârlău și comunele arondate Judecătoriei Hârlău</h2>
            <p>
              Consultanță online sau la cabinetul din Iași, cu posibilitatea deplasării la Hârlău pe bază de
              programare. Cabinetul din Hârlău se deschide în curând.
            </p>
          </div>
          <ul class="chips" aria-label="Localități deservite">
            {localities.map((l) => <li>{l}</li>)}
          </ul>
        </div>
      </section>

      <!-- FAQ -->
      <section class="section" id="intrebari">
        <div class="wrap faq">
          <header class="section__head section__head--left">
            <p class="eyebrow eyebrow--dark">Întrebări frecvente</p>
            <h2>Ce ne întreabă cel mai des clienții</h2>
          </header>
          <div class="faq__list">
            {
              faq.map((item) => (
                <details>
                  <summary>{item.q}</summary>
                  <p>{item.a}</p>
                </details>
              ))
            }
          </div>
        </div>
      </section>

      <!-- CONTACT -->
      <section class="section section--paper" id="contact">
        <div class="wrap contact">
          <div class="contact__intro">
            <p class="eyebrow eyebrow--dark">Contact</p>
            <h2>Programați o consultație</h2>
            <p>
              Cel mai rapid mă găsiți la telefon sau pe WhatsApp. Stabilim împreună dacă ne vedem online, la Iași
              sau la Hârlău.
            </p>
            <div class="hero__actions">
              <a href={phoneHref} class="btn btn--gold">Sună · {phone}</a>
              <a href={whatsapp} class="btn btn--outline" target="_blank" rel="noopener noreferrer">WhatsApp</a>
            </div>
          </div>
          <dl class="contact__list">
            <div>
              <dt>Telefon</dt>
              <dd><a href={phoneHref}>{phone}</a></dd>
            </div>
            <div>
              <dt>Email</dt>
              <dd><a href={`mailto:${email}`}>{email}</a></dd>
            </div>
            <div>
              <dt>Cabinet Iași</dt>
              <dd>Str. Anastasie Panu 23, Bloc Muntenia, Et. 1</dd>
            </div>
            <div>
              <dt>Cabinet Hârlău</dt>
              <dd>În curând — programări prin telefon</dd>
            </div>
            <div>
              <dt>Program</dt>
              <dd>Luni – Vineri, 09:00 – 17:00</dd>
            </div>
          </dl>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="wrap footer__inner">
        <p>© {new Date().getFullYear()} Cabinet Avocat Andreea Chelaru · Membră a Baroului Iași</p>
        <p><a href="https://avocatchelaru.ro/">avocatchelaru.ro</a></p>
      </div>
    </footer>

    <nav class="sticky-cta" aria-label="Contact rapid">
      <a href={phoneHref}>Sună acum</a>
      <a href={whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </nav>
  </body>
</html>
