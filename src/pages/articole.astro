---
import Base from "../layouts/Base.astro";
import PageHero from "../components/PageHero.astro";
import CtaBand from "../components/CtaBand.astro";
import Icon from "../components/Icon.astro";
import { listedArticles, ARTICLE_CATEGORIES, articlePath, publishedArticles, formatArticleDate } from "../data/articles";
import { SERVICE_HERO_IMAGE } from "../data/service-hero";
import { SITE } from "../data/site";
export const prerender = true;
const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Articole juridice",
  url: `${SITE.url}/articole`,
  mainEntity: {
    "@type": "ItemList",
    itemListElement: publishedArticles.map((a, i) => ({
      "@type": "ListItem",
      position: i + 1,
      name: a.title,
      url: `${SITE.url}${articlePath(a)}`,
    })),
  },
};
---

<Base
  title="Articole juridice – informații utile"
  description="Articole despre familie, proprietate, muncă și ședere în România. Caută după subiect și descoperă explicații juridice utile."
  path="/articole"
  jsonLd={[schema]}
>
  <PageHero
    service
    eyebrow="Informații utile"
    title="Mai multă claritate. Decizii informate."
    lead="Descoperă explicații juridice și perspective despre situații care te pot privi pe tine, familia sau afacerea ta."
    crumbs={[{ label: "Articole" }]}
    image={SERVICE_HERO_IMAGE}
  />
  <section
    class="section articles-section"
    id="lista-articole"
    aria-labelledby="articles-title"
  >
    <div class="wrap">
      <header class="section__head">
        <p class="eyebrow">Articole juridice</p>
        <h2 id="articles-title">Ce e bine să știi.</h2>
        <p class="articles-source">
          Perspective și explicații juridice pentru tine, familia și afacerea ta.
        </p>
      </header>
      <div class="articles-tools" hidden>
        <div class="articles-search">
          <label for="article-search">Caută un articol</label>
          <input
            id="article-search"
            type="search"
            placeholder="De exemplu: divorț, pensie, proprietate…"
            autocomplete="off"
          />
        </div>
        <div
          class="articles-filters"
          role="group"
          aria-label="Filtrează după domeniu"
        >
          {["Toate", ...ARTICLE_CATEGORIES].map((category, i) => (
            <button
              type="button"
              data-category={category}
              aria-pressed={i === 0 ? "true" : "false"}
            >
              {category}
            </button>
          ))}
        </div>
        <p
          class="articles-count"
          role="status"
          aria-live="polite"
          aria-atomic="true"
        >
          {listedArticles.length} articole
        </p>
      </div>
      <ul class="articles-grid">
        {listedArticles.map((article) => (
          <li
            class:list={[
              "article-card",
              { "article-card--featured": article.featured },
            ]}
            data-article
            data-category={article.category}
            data-search={`${article.title} ${article.summary} ${article.category}`}
          >
            {article.featured && (
              <picture class="article-card__image" aria-hidden="true">
                <source
                  type="image/avif"
                  srcset={article.image
                    ? `${article.image.base}-480w.avif 480w, ${article.image.base}-768w.avif 768w, ${article.image.base}-1200w.avif 1200w`
                    : "/images/hero/hero-biserica-balanta-v2-480w.avif 480w, /images/hero/hero-biserica-balanta-v2-768w.avif 768w"}
                  sizes="(max-width: 767px) 100vw, 40vw"
                />
                <img
                  src={article.image
                    ? `${article.image.base}-768w.webp`
                    : "/images/hero/hero-biserica-balanta-v2-768w.webp"}
                  srcset={article.image
                    ? `${article.image.base}-480w.webp 480w, ${article.image.base}-768w.webp 768w, ${article.image.base}-1200w.webp 1200w`
                    : undefined}
                  sizes="(max-width: 767px) 100vw, 40vw"
                  width="768"
                  height={article.image ? 432 : 960}
                  style={article.image?.position ? `object-position: ${article.image.position}` : undefined}
                  alt=""
                  loading="lazy"
                />
              </picture>
            )}
            <div class="article-card__body">
              {article.featured && <p class="eyebrow">Articol recomandat</p>}
              <div class="article-card__meta">
                <span>{article.category}</span>
                {article.date && <time datetime={article.date}>{formatArticleDate(article.date)}</time>}
                {article.status === "draft" && <span class="article-draft">În pregătire</span>}
              </div>
              <h3>
                <a href={articlePath(article)}>{article.title}</a>
              </h3>
              <p>{article.summary}</p>
              <a
                href={articlePath(article)}
                class="text-link"
                aria-label={`Citește: ${article.title}`}
              >
                Citește articolul <Icon />
              </a>
            </div>
          </li>
        ))}
      </ul>
      <div class="articles-empty" hidden>
        <h3>Nu am găsit articole.</h3>
        <p>Încearcă un alt cuvânt sau alege un alt domeniu.</p>
        <button class="btn btn--outline" type="button" data-reset-articles>
          Resetează filtrele
        </button>
      </div>
    </div>
  </section>
  <CtaBand />
</Base>
<script>
  const section = document.querySelector<HTMLElement>(".articles-section");
  if (section) {
    const tools = section.querySelector<HTMLElement>(".articles-tools")!;
    const search = section.querySelector<HTMLInputElement>("#article-search")!;
    const buttons = Array.from(
      section.querySelectorAll<HTMLButtonElement>(
        "[data-category]:not([data-article])",
      ),
    );
    const cards = Array.from(
      section.querySelectorAll<HTMLElement>("[data-article]"),
    );
    const count = section.querySelector<HTMLElement>(".articles-count")!;
    const empty = section.querySelector<HTMLElement>(".articles-empty")!;
    const normalize = (value: string) =>
      value
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLocaleLowerCase("ro")
        .trim();
    let category = "Toate";
    const update = () => {
      const words = normalize(search.value).split(/\s+/).filter(Boolean);
      let visible = 0;
      for (const card of cards) {
        const matches =
          (category === "Toate" || card.dataset.category === category) &&
          words.every((word) =>
            normalize(card.dataset.search || "").includes(word),
          );
        card.hidden = !matches;
        if (matches) visible++;
      }
      buttons.forEach((button) =>
        button.setAttribute(
          "aria-pressed",
          String(button.dataset.category === category),
        ),
      );
      count.textContent = visible === 1 ? "1 articol" : `${visible} articole`;
      empty.hidden = visible > 0;
    };
    buttons.forEach((button) =>
      button.addEventListener("click", () => {
        category = button.dataset.category!;
        update();
      }),
    );
    search.addEventListener("input", update);
    section
      .querySelector("[data-reset-articles]")
      ?.addEventListener("click", () => {
        category = "Toate";
        search.value = "";
        update();
        search.focus();
      });
    tools.hidden = false;
  }
</script>
