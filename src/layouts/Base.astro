---
import "../styles/fonts.css";
import "../styles/global.css";
import "../styles/home.css";
import "../styles/footer.css";
import Icon from "../components/Icon.astro";
import BrandLogo from "../components/BrandLogo.astro";
import { SITE, TEAM, AREAS, FOOTER_AREAS } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Phone for the mobile call bar and menu; defaults to the site's main number. */
  phone?: { display: string; href: string };
}

const {
  title,
  description,
  path,
  jsonLd = [],
  noindex = false,
  ogType = "website",
  phone = { display: SITE.phone, href: SITE.phoneHref },
} = Astro.props;

const canonical = path === "/" ? `${SITE.url}/` : `${SITE.url}${path}`;
// Keep titles under ~60 chars so Google doesn't truncate them.
const suffix = ` | ${SITE.name}`;
const fullTitle =
  title.includes(SITE.name) || title.length + suffix.length > 62
    ? title
    : `${title}${suffix}`;
const ogImage = `${SITE.url}${SITE.ogImage}`;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const areaActive =
  current === "/servicii" || AREAS.some((a) => current === `/${a.slug}`);

// Describe the website and the individual lawyers without implying employment or a joint entity.
const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": `${SITE.url}/#website`,
  name: SITE.name,
  url: `${SITE.url}/`,
  inLanguage: "ro-RO",
  about: TEAM.map((p) => ({ "@id": `${SITE.url}/#${p.slug}` })),
};
const people = TEAM.map((p) => ({
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": `${SITE.url}/#${p.slug}`,
  name: p.name,
  jobTitle: "Avocat",
  telephone: p.phone,
  url: `${SITE.url}/despre-noi#${p.slug}`,
  image: `${SITE.url}${p.portraitBase || `/images/echipa/${p.slug}`}-600w.webp`,
}));
const schemas = [websiteSchema, ...people, ...jsonLd];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large" />
    )}
    <meta name="theme-color" content="#F8F6F2" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="RO-IS" />
    <meta name="geo.placename" content="Hârlău" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" hreflang="ro-RO" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="AvocatHârlău.ro – Chelaru, Botezatu, Chiperi"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link
      rel="preload"
      href="/fonts/editorial/fraunces-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/editorial/manrope-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <noscript>
      <style>
        .nav__drop-btn {
          display: none !important;
        }
        .nav__menu {
          display: none !important;
        }
      </style>
    </noscript>
    <slot name="head" />

    {schemas.map((s) => (
      <script
        type="application/ld+json"
        is:inline
        set:html={JSON.stringify(s)}
      />
    ))}
  </head>

  <body class:list={[{ "page--home": path === "/" }]}>
    <a class="skip" href="#continut" data-skip>
      Sari la conținut
    </a>

    <header class="topbar">
      <div class="wrap topbar__inner">
        <a
          href="/"
          class="brand"
          aria-label="AvocatHârlău.ro – pagina principală"
        >
          <BrandLogo />
        </a>
        <button
          class="menu-btn"
          type="button"
          aria-expanded="false"
          aria-controls="meniu"
          aria-label="Deschide meniul"
        >
          <span></span>
          <span></span>
          <span></span>
        </button>
        <nav class="nav" id="meniu" aria-label="Navigare principală">
          <a href="/" aria-current={current === "/" ? "page" : undefined}>
            Acasă
          </a>
          <div class="nav__drop">
            <noscript>
              <a class="nav__fallback" href="/servicii">
                Servicii
              </a>
            </noscript>
            <button
              type="button"
              class:list={["nav__drop-btn", { "is-active": areaActive }]}
              aria-expanded="false"
              aria-controls="domenii"
            >
              Servicii <span aria-hidden="true">⌄</span>
            </button>
            <ul class="nav__menu" id="domenii">
              {[{ slug: "servicii", title: "Toate serviciile" }, ...AREAS].map(
                (a) => (
                  <li>
                    <a
                      href={`/${a.slug}`}
                      aria-current={
                        current === `/${a.slug}` ? "page" : undefined
                      }
                    >
                      {a.title}
                    </a>
                  </li>
                ),
              )}
            </ul>
          </div>
          <a
            href="/articole"
            aria-current={current === "/articole" || current.startsWith("/articole/") ? "page" : undefined}
          >
            Articole
          </a>
          <a
            href="/despre-noi"
            aria-current={current === "/despre-noi" ? "page" : undefined}
          >
            Despre noi
          </a>
          <a
            href="/contact"
            aria-current={current === "/contact" ? "page" : undefined}
          >
            Contact
          </a>
          <a href={phone.href} class="nav__call">
            Sună · {phone.display}
          </a>
        </nav>
        <a href="/contact" class="btn btn--gold btn--sm topbar__call">
          Programează o consultație <Icon />
        </a>
      </div>
    </header>

    <main id="continut" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <a
            href="/"
            class="brand brand--footer"
            aria-label="AvocatHârlău.ro – pagina principală"
          >
            <BrandLogo />
          </a>
          <p>
            Consultanță și reprezentare juridică pentru Hârlău, Cotnari și
            împrejurimi.
          </p>
          <ul class="footer__social">
            <li>
              <a href={SITE.facebook} target="_blank" rel="noopener noreferrer">
                Facebook
              </a>
            </li>
            <li>
              <a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">
                LinkedIn
              </a>
            </li>
          </ul>
        </div>
        <div class="footer__contact">
          <p class="footer__title">Contact</p>
          <ul class="footer__people">
            {TEAM.map((p) => (
              <li>
                <span class="footer__name">{p.name}</span>
                <a href={p.phoneHref}>{p.phone}</a>
              </li>
            ))}
          </ul>
          <p class="footer__line">
            <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
          </p>
        </div>
        <nav class="footer__services" aria-label="Domenii de activitate">
          <p class="footer__title">Domenii de activitate</p>
          <ul>
            {FOOTER_AREAS.map((a) => (
              <li>
                <a href={`/${a.slug}`}>{a.title}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav class="footer__navigation" aria-label="Cabinet">
          <p class="footer__title">Navigare</p>
          <ul>
            <li>
              <a href="/articole">Articole</a>
            </li>
            <li>
              <a href="/">Acasă</a>
            </li>
            <li>
              <a href="/despre-noi">Despre noi</a>
            </li>
            <li>
              <a href="/servicii">Toate serviciile</a>
            </li>
            <li>
              <a href="/contact">Contact</a>
            </li>
            <li>
              <a href="/politica-de-confidentialitate">
                Politica de confidențialitate
              </a>
            </li>
            <li>
              <a href="/termeni-si-conditii">Termeni și condiții</a>
            </li>
          </ul>
        </nav>
      </div>
      <div class="wrap footer__bottom">
        <p>
          © {new Date().getFullYear()} {SITE.name} – {SITE.firm}. Toate
          drepturile rezervate.
        </p>
        <nav class="footer__legal" aria-label="Legal">
          <a href="/politica-de-confidentialitate">
            Politica de confidențialitate
          </a>
          <a href="/termeni-si-conditii">Termeni și condiții</a>
          <a href="/politica-de-confidentialitate#cookie-uri">Cookie-uri</a>
        </nav>
        <div class="footer__credit">
          <span>Website realizat de</span>
          <a
            href="https://bluepixel.ro"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="BluePixel"
          >
            <img
              src="/images/bluepixel-logo.svg"
              alt="BluePixel — Clean web. Built right."
              width="158"
              height="36"
              loading="lazy"
              decoding="async"
            />
          </a>
        </div>
      </div>
    </footer>

    <nav class="sticky-cta" aria-label="Contact rapid">
      <a href={phone.href}>Sună acum</a>
      <a href="/contact">Programare</a>
    </nav>

    <script>
      const btn = document.querySelector<HTMLButtonElement>(".menu-btn")!;
      const nav = document.getElementById("meniu")!;
      const drop = document.querySelector<HTMLElement>(".nav__drop")!;
      const dropBtn = drop.querySelector<HTMLButtonElement>(".nav__drop-btn")!;
      const header = document.querySelector<HTMLElement>(".topbar")!;
      // Enhance only after the handlers are ready; links stay available without JavaScript.
      function setMenu(open: boolean) {
        btn.setAttribute("aria-expanded", String(open));
        btn.setAttribute(
          "aria-label",
          open ? "Închide meniul" : "Deschide meniul",
        );
        nav.classList.toggle("is-open", open);
      }
      function setDrop(open: boolean) {
        dropBtn.setAttribute("aria-expanded", String(open));
        drop.classList.toggle("is-open", open);
      }
      btn.addEventListener("click", () =>
        setMenu(btn.getAttribute("aria-expanded") !== "true"),
      );
      dropBtn.addEventListener("click", () =>
        setDrop(dropBtn.getAttribute("aria-expanded") !== "true"),
      );
      document.addEventListener("click", (e) => {
        if (!drop.contains(e.target as Node)) setDrop(false);
        if (!header.contains(e.target as Node)) setMenu(false);
      });
      nav.addEventListener("click", (e) => {
        if ((e.target as Element).closest("a")) setMenu(false);
      });
      header.addEventListener("focusout", () => {
        requestAnimationFrame(() => {
          if (!drop.contains(document.activeElement)) setDrop(false);
          if (!header.contains(document.activeElement)) setMenu(false);
        });
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
          if (dropBtn.getAttribute("aria-expanded") === "true") {
            setDrop(false);
            dropBtn.focus();
          } else if (btn.getAttribute("aria-expanded") === "true") {
            setMenu(false);
            btn.focus();
          }
        }
      });
      const desktop = matchMedia("(min-width: 1021px)");
      desktop.addEventListener("change", () => {
        setMenu(false);
        setDrop(false);
      });
      let ticking = false;
      function scrollState() {
        if (!ticking)
          requestAnimationFrame(() => {
            header.classList.toggle("is-scrolled", scrollY > 16);
            ticking = false;
          });
        ticking = true;
      }
      window.addEventListener("scroll", scrollState, { passive: true });
      scrollState();
      document.documentElement.classList.add("nav-ready");
      const reduced = matchMedia("(prefers-reduced-motion: reduce)");
      if (!reduced.matches && "IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.08 },
        );
        document
          .querySelectorAll<HTMLElement>("[data-reveal]")
          .forEach((el) => {
            el.classList.add("reveal-ready");
            observer.observe(el);
          });
        reduced.addEventListener("change", (e) => {
          if (e.matches) {
            observer.disconnect();
            document
              .querySelectorAll(".reveal-ready")
              .forEach((el) => el.classList.add("is-visible"));
          }
        });
      }
    </script>
  </body>
</html>
