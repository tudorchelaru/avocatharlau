---
import "../styles/global.css";
import { SITE, NAV, SERVICES } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: "website" | "article";
}

const { title, description, path, jsonLd = [], noindex = false, ogType = "website" } = Astro.props;

const canonical = path === "/" ? `${SITE.url}/` : `${SITE.url}${path}`;
// Keep titles under ~60 chars so Google doesn't truncate them.
const suffix = " | Andreea Chelaru";
const fullTitle = title.includes("Andreea Chelaru") || title.length + suffix.length > 62 ? title : `${title}${suffix}`;
const ogImage = `${SITE.url}${SITE.ogImage}`;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) => current === href || current.startsWith(`${href}/`);

const legalService = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "@id": `${SITE.url}/#cabinet`,
  name: "Cabinet Avocat Andreea Chelaru – Hârlău",
  url: `${SITE.url}/`,
  telephone: SITE.phone,
  email: SITE.email,
  image: ogImage,
  logo: `${SITE.url}/images/logo.webp`,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Str. Anastasie Panu 23, Bloc Muntenia, Et. 1",
    addressLocality: "Iași",
    addressRegion: "Iași",
    addressCountry: "RO",
  },
  areaServed: [
    { "@type": "City", name: "Hârlău" },
    { "@type": "City", name: "Cotnari" },
    { "@type": "AdministrativeArea", name: "Județul Iași" },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "17:00",
  },
  founder: {
    "@type": "Person",
    "@id": `${SITE.url}/#andreea-chelaru`,
    name: "Andreea Chelaru",
    jobTitle: "Avocat",
    memberOf: { "@type": "Organization", name: "Baroul Iași", url: "https://www.barouliasi.ro/" },
  },
  sameAs: ["https://avocatchelaru.ro/", "https://www.barouliasi.ro/"],
};

const schemas = [legalService, ...jsonLd];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="author" content="Andreea Chelaru" />
    <meta name="theme-color" content="#13110F" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="RO-IS" />
    <meta name="geo.placename" content="Hârlău" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" hreflang="ro-RO" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Avocat Andreea Chelaru – Hârlău" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />

    {schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
  </head>

  <body>
    <a class="skip" href="/" data-skip>Sari la conținut</a>

    <header class="topbar">
      <div class="wrap topbar__inner">
        <a href="/" class="brand" aria-label="Andreea Chelaru – Avocat, pagina principală">
          <img src="/images/logo.webp" alt="Andreea Chelaru – Avocat" width="600" height="121" />
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="meniu" aria-label="Deschide meniul">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav" id="meniu" aria-label="Navigare principală">
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined}>
                {item.label}
              </a>
            ))
          }
          <a href={SITE.phoneHref} class="nav__call">Sună · {SITE.phone}</a>
        </nav>
        <a href={SITE.phoneHref} class="btn btn--gold btn--sm topbar__call">{SITE.phone}</a>
      </div>
    </header>

    <main id="continut" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <img src="/images/logo.webp" alt="Andreea Chelaru – Avocat" width="600" height="121" loading="lazy" />
          <p>
            Consultanță și reprezentare juridică pentru clienții din Hârlău și zona Cotnari. Membră a Baroului Iași din
            {SITE.since}.
          </p>
        </div>
        <nav aria-label="Servicii">
          <p class="footer__title">Servicii</p>
          <ul>
            {SERVICES.map((s) => <li><a href={`/servicii/${s.slug}`}>{s.title}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="Pagini">
          <p class="footer__title">Cabinet</p>
          <ul>
            {NAV.filter((n) => n.href !== "/servicii").map((n) => <li><a href={n.href}>{n.label}</a></li>)}
          </ul>
        </nav>
        <div>
          <p class="footer__title">Contact</p>
          <ul>
            <li><a href={SITE.phoneHref}>{SITE.phone}</a></li>
            <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
            <li>{SITE.hours}</li>
          </ul>
        </div>
      </div>
      <div class="wrap footer__bottom">
        <p>© {new Date().getFullYear()} Cabinet Avocat Andreea Chelaru</p>
        <p><a href="/">avocatharlau.ro</a></p>
      </div>
    </footer>

    <nav class="sticky-cta" aria-label="Contact rapid">
      <a href={SITE.phoneHref}>Sună acum</a>
      <a href={SITE.whatsapp} target="_blank" rel="noopener noreferrer">WhatsApp</a>
    </nav>

    <script is:inline>
      (function () {
        var btn = document.querySelector(".menu-btn");
        var nav = document.getElementById("meniu");
        btn.addEventListener("click", function () {
          var open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", String(!open));
          btn.setAttribute("aria-label", open ? "Deschide meniul" : "Închide meniul");
          nav.classList.toggle("is-open", !open);
        });
        // Skip link without adding "#" to the URL.
        document.querySelector("[data-skip]").addEventListener("click", function (e) {
          e.preventDefault();
          document.getElementById("continut").focus();
        });
      })();
    </script>
  </body>
</html>
