---
import "../styles/global.css";
import { SITE, TEAM, AREAS, FOOTER_AREAS } from "../data/site";

interface Props {
  title: string;
  description: string;
  path: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: "website" | "article";
  /** Phone for the mobile call bar and menu; defaults to the site's main number. */
  phone?: { display: string; href: string };
}

const {
  title,
  description,
  path,
  jsonLd = [],
  noindex = false,
  ogType = "website",
  phone = { display: SITE.phone, href: SITE.phoneHref },
} = Astro.props;

const canonical = path === "/" ? `${SITE.url}/` : `${SITE.url}${path}`;
// Keep titles under ~60 chars so Google doesn't truncate them.
const suffix = ` | ${SITE.name}`;
const fullTitle = title.includes(SITE.name) || title.length + suffix.length > 62 ? title : `${title}${suffix}`;
const ogImage = `${SITE.url}${SITE.ogImage}`;
const current = Astro.url.pathname.replace(/\/$/, "") || "/";
const areaActive = AREAS.some((a) => current === `/${a.slug}`);
const L = "/images/logo/avocat-harlau-chelaru-botezatu-chiperi-logo";

const legalService = {
  "@context": "https://schema.org",
  "@type": "LegalService",
  "@id": `${SITE.url}/#cabinet`,
  name: `${SITE.name} – ${SITE.firm}`,
  url: `${SITE.url}/`,
  telephone: SITE.phone,
  email: SITE.email,
  image: ogImage,
  logo: `${SITE.url}${SITE.logoPng}`,
  slogan: SITE.tagline,
  address: {
    "@type": "PostalAddress",
    streetAddress: "Str. Anastasie Panu nr. 23, bl. Muntenia, sc. B, et. 1, ap. 1",
    addressLocality: "Iași",
    addressRegion: "Iași",
    addressCountry: "RO",
  },
  areaServed: [
    { "@type": "City", name: "Hârlău" },
    { "@type": "City", name: "Cotnari" },
    { "@type": "AdministrativeArea", name: "Județul Iași" },
  ],
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "09:00",
    closes: "17:00",
  },
  employee: TEAM.map((p) => ({
    "@type": "Person",
    "@id": `${SITE.url}/#${p.slug}`,
    name: p.name,
    jobTitle: "Avocat",
    telephone: p.phone,
  })),
  knowsAbout: AREAS.map((a) => a.title),
  sameAs: [SITE.facebook, SITE.linkedin],
};

const schemas = [legalService, ...jsonLd];
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />
    <meta name="geo.region" content="RO-IS" />
    <meta name="geo.placename" content="Hârlău" />

    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="alternate" hreflang="ro-RO" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AvocatHârlău.ro – Chelaru, Botezatu, Chiperi" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Mulish:ital,wght@0,400;0,500;0,600;0,700;0,800;1,500&display=swap"
      rel="stylesheet"
    />
    <slot name="head" />

    {schemas.map((s) => <script type="application/ld+json" is:inline set:html={JSON.stringify(s)} />)}
  </head>

  <body>
    <a class="skip" href="/" data-skip>Sari la conținut</a>

    <header class="topbar">
      <div class="wrap topbar__inner">
        <a href="/" class="brand" aria-label="AvocatHârlău.ro – pagina principală">
          <picture>
            <source type="image/avif" srcset={`${L}-480w.avif 480w, ${L}-960w.avif 960w`} sizes="260px" />
            <img
              src={`${L}-480w.webp`}
              srcset={`${L}-480w.webp 480w, ${L}-960w.webp 960w`}
              sizes="260px"
              alt="AvocatHârlău.ro – Chelaru, Botezatu, Chiperi"
              width="960"
              height="167"
              fetchpriority="high"
            />
          </picture>
        </a>
        <button class="menu-btn" type="button" aria-expanded="false" aria-controls="meniu" aria-label="Deschide meniul">
          <span></span><span></span><span></span>
        </button>
        <nav class="nav" id="meniu" aria-label="Navigare principală">
          <a href="/" aria-current={current === "/" ? "page" : undefined}>Acasă</a>
          <a href="/despre-noi" aria-current={current === "/despre-noi" ? "page" : undefined}>Despre noi</a>
          <div class="nav__drop">
            <button
              type="button"
              class:list={["nav__drop-btn", { "is-active": areaActive }]}
              aria-expanded="false"
              aria-controls="domenii"
            >
              Domenii de activitate
            </button>
            <ul class="nav__menu" id="domenii">
              {
                AREAS.map((a) => (
                  <li>
                    <a href={`/${a.slug}`} aria-current={current === `/${a.slug}` ? "page" : undefined}>
                      {a.title}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
          <a href="/contact" aria-current={current === "/contact" ? "page" : undefined}>Contact</a>
          <a href={phone.href} class="nav__call">Sună · {phone.display}</a>
        </nav>
        <a href="/contact" class="btn btn--gold btn--sm topbar__call">Programează o consultație</a>
      </div>
    </header>

    <main id="continut" tabindex="-1">
      <slot />
    </main>

    <footer class="footer">
      <div class="wrap footer__grid">
        <div class="footer__brand">
          <picture>
            <source type="image/avif" srcset={`${L}-480w.avif 480w, ${L}-960w.avif 960w`} sizes="240px" />
            <img
              src={`${L}-480w.webp`}
              srcset={`${L}-480w.webp 480w, ${L}-960w.webp 960w`}
              sizes="240px"
              alt="AvocatHârlău.ro – Chelaru, Botezatu, Chiperi"
              width="960"
              height="167"
              loading="lazy"
              decoding="async"
            />
          </picture>
          <p>{SITE.tagline}</p>
          <ul class="footer__social">
            <li><a href={SITE.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
            <li><a href={SITE.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a></li>
          </ul>
        </div>
        <div>
          <p class="footer__title">Contact</p>
          <ul class="footer__people">
            {
              TEAM.map((p) => (
                <li>
                  <span class="footer__name">{p.name}</span>
                  <a href={p.phoneHref}>{p.phone}</a>
                </li>
              ))
            }
          </ul>
          <p class="footer__line"><a href={`mailto:${SITE.email}`}>{SITE.email}</a></p>
          <p class="footer__line">{SITE.address}</p>
        </div>
        <nav aria-label="Domenii de activitate">
          <p class="footer__title">Domenii de activitate</p>
          <ul>
            {FOOTER_AREAS.map((a) => <li><a href={`/${a.slug}`}>{a.title}</a></li>)}
          </ul>
        </nav>
        <nav aria-label="Cabinet">
          <p class="footer__title">Cabinet</p>
          <ul>
            <li><a href="/despre-noi">Despre noi</a></li>
            <li><a href="/contact">Contact</a></li>
            <li><a href="/politica-de-confidentialitate">Politica de confidențialitate</a></li>
            <li><a href="/termeni-si-conditii">Termeni și condiții</a></li>
          </ul>
        </nav>
      </div>
      <div class="wrap footer__bottom">
        <p>© {new Date().getFullYear()} {SITE.name} – {SITE.firm}. Toate drepturile rezervate.</p>
        <nav class="footer__legal" aria-label="Legal">
          <a href="/politica-de-confidentialitate">Politica de confidențialitate</a>
          <a href="/termeni-si-conditii">Termeni și condiții</a>
        </nav>
      </div>
    </footer>

    <nav class="sticky-cta" aria-label="Contact rapid">
      <a href={phone.href}>Sună acum</a>
      <a href="/contact">Programare</a>
    </nav>

    <script is:inline>
      (function () {
        var btn = document.querySelector(".menu-btn");
        var nav = document.getElementById("meniu");
        btn.addEventListener("click", function () {
          var open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", String(!open));
          btn.setAttribute("aria-label", open ? "Deschide meniul" : "Închide meniul");
          nav.classList.toggle("is-open", !open);
        });
        var drop = document.querySelector(".nav__drop");
        var dropBtn = drop.querySelector(".nav__drop-btn");
        function setDrop(open) {
          dropBtn.setAttribute("aria-expanded", String(open));
          drop.classList.toggle("is-open", open);
        }
        dropBtn.addEventListener("click", function () {
          setDrop(dropBtn.getAttribute("aria-expanded") !== "true");
        });
        document.addEventListener("click", function (e) {
          if (!drop.contains(e.target)) setDrop(false);
        });
        document.addEventListener("keydown", function (e) {
          if (e.key === "Escape") setDrop(false);
        });
        // Skip link without adding "#" to the URL.
        document.querySelector("[data-skip]").addEventListener("click", function (e) {
          e.preventDefault();
          document.getElementById("continut").focus();
        });
      })();
    </script>
  </body>
</html>
